{
  "name": "streaming-copilot-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "15.5.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "axe-core": "^4.13.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.25",
    "jsdom": "^30.1.1",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vitest": "5.0.1"
  },
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver",
      "sharp"
    ],
    "overrides": {
      "postcss": ">=8.5.18"
    }
  }
}
