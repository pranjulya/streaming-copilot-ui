# Local development only. Keep this file at the repository root as .env.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://copilot:copilot@127.0.0.1:5432/copilot
# INSTANCE_ID is a random UUID at boot unless explicitly configured.
# INSTANCE_ID=
# Production requires the key and all three JWT settings; no provider runs in Phase 00.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.6
SYSTEM_PROMPT="You are a helpful Copilot. Answer in Markdown. Do not claim tool use, browsing, or private chain-of-thought. If you are unsure, say so."
# Remove DEV_USER_ID entirely in staging/production.
DEV_USER_ID=dev-user
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_JWT_JWKS_URL=
AUTH_JWT_SUBJECT_CLAIM=sub
AUTH_COOKIE_NAME=
ALLOWED_ORIGINS=http://127.0.0.1:3000
MAX_MESSAGE_CHARS=8000
MAX_OUTPUT_CHARS=100000
MAX_REQUEST_BYTES=65536
CONTEXT_CHAR_BUDGET=120000
MAX_ACTIVE_RUNS_PER_USER=3
CREATE_RESPONSE_PER_MINUTE=20
LEASE_SECONDS=15
LEASE_RENEW_SECONDS=5
PROVIDER_CONNECT_TIMEOUT_SECONDS=10
PROVIDER_IDLE_TIMEOUT_SECONDS=30
GENERATION_TIMEOUT_SECONDS=120
HEARTBEAT_INTERVAL_SECONDS=15
# Streaming/lease defaults below are CALIBRATED for local development by the
# Phase 08 load rehearsal (2026-09-23); see docs/operations/load-report.md and
# docs/configuration.md §7 before changing them.
EVENT_FOLLOW_POLL_MS=50
DELTA_FLUSH_MS=40
DELTA_FLUSH_CHARS=24
SHUTDOWN_GRACE_SECONDS=10
EVENT_RETENTION_HOURS=24
IDEMPOTENCY_TTL_HOURS=24
NEXT_PUBLIC_API_BASE=
