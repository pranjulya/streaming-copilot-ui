# Production edge for the Streaming Copilot UI
#
# Topology (see docs/configuration.md §7):
#   - the edge serves the Next.js app as the web origin
#   - /v1 and /health/live are reverse-proxied to the FastAPI service
#   - /health/ready and /metrics stay on the private network
#
# Secrets (XAI_API_KEY, DATABASE_URL, JWT settings) are injected into the API
# container environment by the platform secret store; they never live in images
# or in the web bundle.

{
	email {$ACME_EMAIL}
}

copilot.example {
	encode zstd gzip

	# Streaming routes must not be buffered by the proxy.
	@streaming {
		path /v1/conversations/*/responses
		path /v1/response-runs/*/stream
		path /v1/response-runs/*/retry
		path /v1/messages/*/regenerations
	}
	reverse_proxy @streaming api:8000 {
		flush_interval -1
	}

	handle /v1/* {
		reverse_proxy api:8000
	}

	handle /health/live {
		reverse_proxy api:8000
	}

	# Readiness and metrics are private-network only.
	handle /health/ready {
		respond 404
	}

	handle /metrics {
		respond 404
	}

	handle {
		reverse_proxy web:3000
	}
}
