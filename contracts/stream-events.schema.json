{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://copilot.local/contracts/stream-events.schema.json",
  "title": "Streaming Copilot V1 producer events",
  "$comment": "Frozen producer schema, not forward-compatible consumer policy. For heartbeat/snapshot, sequence == data.last_sequence is checked by Python and TypeScript fixture tests.",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|\\+00:00)$"
    },
    "conversation_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "data": {
      "type": "object"
    }
  },
  "required": [
    "protocol_version",
    "sequence",
    "event_id",
    "type",
    "occurred_at",
    "conversation_id",
    "run_id",
    "data"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "response.started"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "data": {
          "type": "object",
          "properties": {
            "user_message_id": {
              "type": "string",
              "format": "uuid"
            },
            "assistant_message_id": {
              "type": "string",
              "format": "uuid"
            },
            "client_message_id": {
              "type": "string",
              "format": "uuid"
            },
            "attempt": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "user_message_id",
            "assistant_message_id",
            "client_message_id",
            "attempt"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "message.delta"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "data": {
          "type": "object",
          "properties": {
            "message_id": {
              "type": "string",
              "format": "uuid"
            },
            "delta": {
              "type": "string"
            },
            "content_index": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "message_id",
            "delta",
            "content_index"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "usage.updated"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "data": {
          "type": "object",
          "properties": {
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "input_tokens",
            "output_tokens"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "heartbeat"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "data": {
          "type": "object",
          "properties": {
            "last_sequence": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "last_sequence"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "message.completed"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "data": {
          "type": "object",
          "properties": {
            "message_id": {
              "type": "string",
              "format": "uuid"
            },
            "content": {
              "type": "string"
            },
            "finish_reason": {
              "enum": [
                "stop",
                "length"
              ]
            }
          },
          "required": [
            "message_id",
            "content",
            "finish_reason"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "response.completed"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "data": {
          "type": "object",
          "properties": {
            "finish_reason": {
              "enum": [
                "stop",
                "length"
              ]
            },
            "usage": {
              "type": "object",
              "properties": {
                "input_tokens": {
                  "type": "integer",
                  "minimum": 0
                },
                "output_tokens": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "input_tokens",
                "output_tokens"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "finish_reason",
            "usage"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "response.cancelled"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "data": {
          "type": "object",
          "properties": {
            "reason": {
              "const": "user_requested"
            },
            "partial_content_retained": {
              "type": "boolean"
            },
            "content": {
              "type": "string"
            }
          },
          "required": [
            "reason",
            "partial_content_retained",
            "content"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "response.failed"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "data": {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "provider_unavailable",
                "provider_rate_limited",
                "provider_timeout",
                "provider_protocol_error",
                "output_limit_exceeded",
                "server_restart",
                "persistence_failed",
                "cancelled_cleanup_failed"
              ]
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            },
            "diagnostic_id": {
              "type": "string",
              "format": "uuid"
            },
            "content": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message",
            "retryable",
            "diagnostic_id",
            "content"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "response.snapshot"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "data": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "queued",
                "streaming",
                "cancelling",
                "completed",
                "cancelled",
                "failed"
              ]
            },
            "user_message_id": {
              "type": "string",
              "format": "uuid"
            },
            "assistant_message_id": {
              "type": "string",
              "format": "uuid"
            },
            "content": {
              "type": "string"
            },
            "last_sequence": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "status",
            "user_message_id",
            "assistant_message_id",
            "content",
            "last_sequence"
          ],
          "additionalProperties": false
        }
      }
    }
  ]
}
